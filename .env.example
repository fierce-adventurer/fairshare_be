# ==============================================================================
# Fairshare Backend Environment Configuration (.env)
# ==============================================================================

# Server Profile & Port
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# For Local Docker PostgreSQL:
DATABASE_URL=jdbc:postgresql://localhost:5432/fairshare
DATABASE_USERNAME=fairshare
DATABASE_PASSWORD=fairshare_dev

# For NeonDB / Remote Cloud PostgreSQL:
# DATABASE_URL=jdbc:postgresql://ep-your-project-id.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=your-neon-username
# DATABASE_PASSWORD=your-neon-password

# ------------------------------------------------------------------------------
# Redis In-Memory Cache & Token Store
# ------------------------------------------------------------------------------
# For Upstash / Redis Cloud URL format:
# REDIS_URL=redis://default:password@xxxx:6379 or rediss://default:password@xxxx.upstash.io:6379

# For Local Docker Redis:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# For Redis Cloud (host/port format):
# REDIS_HOST=redis-12345.c10.us-east-1-2.ec2.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_PASSWORD=your-redis-cloud-password

# ------------------------------------------------------------------------------
# JWT Authentication Security
# ------------------------------------------------------------------------------
# 256-bit secret key (HMAC-SHA256). You can generate a new one with: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

# ------------------------------------------------------------------------------
# GitHub OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
# Register a new OAuth App at: https://github.com/settings/applications/new
# Application name: Fairshare (or any recognizable name)
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:8080/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/github/callback

# ------------------------------------------------------------------------------
# Sign in with Apple (Services ID + Sign in with Apple private key)
# Apple web return URLs must be registered HTTPS URLs and cannot use localhost.
# APPLE_PRIVATE_KEY may contain literal \n escape sequences.
# ------------------------------------------------------------------------------
APPLE_CLIENT_ID=com.example.fairshare.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional pre-generated client secret; leave blank to generate it from the key above.
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth/oauth/apple/callback

# ------------------------------------------------------------------------------
# Frontend Ingress & CORS Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
MOBILE_REDIRECT_URI=com.fairshare.app://auth/callback
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Phone OTP delivery
# Use console only in local development. Production should use twilio.
# ------------------------------------------------------------------------------
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_EXPOSE_DEV_CODE=true
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_PEPPER=replace-with-an-independent-random-secret

# ------------------------------------------------------------------------------
# Email verification (SMTP)
# ------------------------------------------------------------------------------
EMAIL_DELIVERY_ENABLED=false
EMAIL_EXPOSE_DEV_LINK=true
EMAIL_FROM=no-reply@fairshare.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# ------------------------------------------------------------------------------
# Server-side WhatsApp payment reminders (Meta WhatsApp Business Cloud API)
# ------------------------------------------------------------------------------
# Leave blank in local development. Reminder attempts remain auditable as
# queued_configuration_required and never redirect the user to WhatsApp.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# ------------------------------------------------------------------------------
# Server-side Instagram reminders (Meta Instagram professional messaging API)
# ------------------------------------------------------------------------------
# Requires instagram_business_manage_messages and an Instagram-scoped recipient
# ID captured after that person messages the connected professional account.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v25.0
